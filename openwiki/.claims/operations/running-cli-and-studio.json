  "claims": [
    {
      "id": "claim_c102914ea9b14ff7a694e400fa7b31a8",
      "statement": "main.py and graph.py compile the same node wiring (gdelt -> triage -> research -> verify -> price -> output) differently: main.py's CLI run compiles graph.build() with an explicit SqliteSaver checkpointer and SqliteStore backed by data/threads.db, while graph.py's module-level `graph = build().compile()` (served by `uv run langgraph dev` via langgraph.json's event_graph entry) is compiled with no checkpointer, relying on the LangGraph Studio dev server's own persistence.",
      "evidence": [
        {
          "resource": "repo://graph.py#L1-L43",
          "version": "repo-lines-v1:sha256:0e6f56fd4860bee517cebed26f46bbb18468724d10f5fe966d9f8b9562e249fa:"
        },
        {
          "resource": "repo://langgraph.json",
          "version": "repo-file-v1:sha256:eaaccad74029505a82bb85c9730213dd0fd377058b648ded3e5d8333baa3b0bf"
        },
        {
          "resource": "repo://main.py#L49-L56",
          "version": "repo-lines-v1:sha256:e21f53486eb49e658f71ceee73b879c9ea8aca8f0a649274f971b843e4c2db8b:"
        }
