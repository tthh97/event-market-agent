    {
      "id": "claim_0fcddd8a9d0f4cb99c1c51401e67815d",
      "statement": "main.py streams the compiled graph with stream_mode=\"updates\", so each yielded step is a single node's changed-field update rather than full state; the describe() helper prints list-valued fields as an item count (`field: N items`) and scalar fields as a JSON-encoded value truncated to 200 characters, giving a per-node console trace of a run.",
      "evidence": [
