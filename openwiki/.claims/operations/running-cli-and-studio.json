    {
      "id": "claim_aae21e4fcba94b76bd3df5af2b15ce2b",
      "statement": "main.py's CLI accepts three invocation shapes: a bare `uv run main.py` (new thread, latest GDELT window), `--date YYYY-MM-DD` (new thread, GDELT window anchored to that day), and `--thread ID \"question\"` (continues thread ID as a follow-up); supplying a question without --thread is rejected by argparse.",
      "evidence": [
        {
          "resource": "repo://main.py#L39-L50",
          "version": "repo-lines-v1:sha256:b8e7ae44cda9a9c41a63e2335469143eb1bd31f30799e89bb24bed7254c1495c:"
        }
