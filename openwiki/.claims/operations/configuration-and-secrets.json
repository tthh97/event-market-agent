    {
      "id": "claim_075c8570d3874746a6c444c8855e6572",
      "statement": "TAVILY_API_KEY is read directly via os.environ[\"TAVILY_API_KEY\"] (not .get) inside the search_news tool in research.py, so a missing key raises a KeyError the first time the research agent invokes the tool, partway through the research node, after gdelt and triage have already checkpointed; an invalid key instead fails inside TavilyClient.search.",
      "evidence": [
