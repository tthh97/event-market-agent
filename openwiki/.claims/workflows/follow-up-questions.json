        }
      ]
    },
    {
      "id": "claim_840c1db4369b4f25b7972f3c920a3520",
      "statement": "graph.py's conditional start edge routes a run to the `research` node instead of `gdelt` purely based on whether the resumed thread's state.report field is already set (i.e. a prior run in this thread produced a report), not based on whether a CLI question string was supplied.",
