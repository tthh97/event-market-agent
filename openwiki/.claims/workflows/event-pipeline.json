    {
      "id": "claim_9483a1495a9d48d9b1e4355aab829129",
      "statement": "gdelt.py's top_stories resolves the 6-hour window from GDELT's lastupdate.txt: without an as_of it uses the newest published update, and with an as_of day it uses the earlier of the newest update and that day's 23:45 UTC, raising ValueError if as_of is later than GDELT's newest update.",
      "evidence": [
        {
          "resource": "repo://gdelt.py#L72-L85",
          "version": "repo-lines-v1:sha256:272cf7a34387f025dcdcc6fbb298d142c8962cb78d2b630a7dfb2b65c5d810a4:"
        }
      ]
    },
    {
      "id": "claim_4ee948bf2d344a3fafed9920b7d5ac4e",
      "statement": "gdelt.py deduplicates downloads by querying events.db's gkg_file table for the 24 fifteen-minute timestamps already stored and fetching only the missing ones in parallel via an 8-worker ThreadPoolExecutor.",
      "evidence": [
        {
          "resource": "repo://gdelt.py#L82-L93",
          "version": "repo-lines-v1:sha256:74706cbbeb71eebbd10fe4512c73927db497c969b6af3319e423977ce9b1eec2:"
        }
      ]
    },
    {
      "id": "claim_5be285558edb4054b03b4d88144eecd4",
      "statement": "gdelt.py inserts a downloaded file's gkg_row rows and its gkg_file marker in a single database transaction, so a crash mid-insert leaves the file retryable rather than marked fetched-but-empty; a 404 response is recorded as a file with 0 rows.",
      "evidence": [
        {
          "resource": "repo://gdelt.py#L37-L43",
          "version": "repo-lines-v1:sha256:9cab7e3b3c2115a117a4c96d5121586f2c7f1d59ce15c644f7fee00d739628e0:"
