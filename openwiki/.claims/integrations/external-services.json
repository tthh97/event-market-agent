    {
      "id": "claim_55fa8e698d6849ac8316a392139ffbd1",
      "statement": "Tavily is called only from inside the search_news tool in research.py, using os.environ['TAVILY_API_KEY'] (not os.getenv), so a missing key raises KeyError on the tool's first invocation and LangChain's default tool-error handling re-raises it, stopping the run inside the research node with no report written; there is no fallback path.",
      "evidence": [
        {
          "resource": "repo://research.py#L100-L117",
