    {
      "id": "claim_6706091ec3ab42bd924c3cdd71714178",
      "statement": "verify.py applies fixed probability thresholds to Jev's per-claim answers: supported or current below DOUBT=0.4 removes the claim, below SURE=0.7 (but at or above DOUBT) keeps it with unverified=True, and a sector is attached to the claim only when Jev's sector-choice confidence is at least SECTOR_SURE=0.75 and the chosen sector is not 'none'.",
      "evidence": [
        {
          "resource": "repo://verify.py#L19-L20",
