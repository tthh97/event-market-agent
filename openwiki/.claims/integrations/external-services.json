        }
      ]
    },
    {
      "id": "claim_87a56bf6982544318e4048779d6400ee",
      "statement": "triage.py keeps exactly KEEP=3 stories with the highest Jev severity score and applies no minimum-score threshold, because on 30 Sep 2026 the highest of 100 candidate stories scored 1.07, meaning a floor at 1.0 or 2.0 would have kept nothing.",
      "evidence": [
        {
          "resource": "repo://triage.py#L1-L9",
          "version": "repo-lines-v1:sha256:b6141ec1991dce974eda6dbe74acf6c9b197d703670c3bb87bd4bf81b9745925:"
