  "claims": [
    {
      "id": "claim_539fce3b001a440eb7fc5f36e7d62d13",
      "statement": "gdelt.py downloads the GDELT GKG 2.1 feed with no authentication, fetching lastupdate.txt to find the newest 15-minute update and then up to UPDATES=24 15-minute .gkg.csv.zip files (6 hours), skipping timestamps already recorded in the gkg_file table of data/events.db and fetching the rest 8 at a time via a ThreadPoolExecutor.",
      "evidence": [
        {
          "resource": "repo://gdelt.py#L25-L96",
          "version": "repo-lines-v1:sha256:50a7fe7dc8da55ee2cf37c8667a0193c121014b2a8a96d3362eb490ce96fdafd:"
        }
      ]
    },
    {
      "id": "claim_43e7ee933c444a32898a9f72a5139dfd",
      "statement": "gdelt.py:http_get treats an HTTP 404 response from GDELT as a skipped update and returns None instead of raising, while any other non-2xx status raises via httpx's raise_for_status and stops the run; a --date later than GDELT's newest update raises ValueError before any download.",
      "evidence": [
        {
          "resource": "repo://gdelt.py#L37-L43",
          "version": "repo-lines-v1:sha256:9cab7e3b3c2115a117a4c96d5121586f2c7f1d59ce15c644f7fee00d739628e0:"
        },
        {
          "resource": "repo://gdelt.py#L75-L81",
          "version": "repo-lines-v1:sha256:f1350f355e6a5351d74d79687802132abfb1fab33880cd2f3671a3465d099b65:"
        }
      ]
    },
    {
      "id": "claim_32591d19cc3d44de855bd6cffdf75535",
      "statement": "gdelt.py reads fixed GKG 2.1 columns (SITE, URL, THEMES, LOCATIONS, PERSONS, ORGANIZATIONS, EXTRAS) from each tab-separated row, keeping only rows whose THEMES intersect a fixed 13-theme MARKET_THEMES set and that contain a <PAGE_TITLE> extracted from the EXTRAS column and a non-empty GKGRECORDID.",
      "evidence": [
        {
          "resource": "repo://gdelt.py#L29-L69",
          "version": "repo-lines-v1:sha256:bef4491db36dcb6d7b5bc0c205c010837d0fecdde71c64f76bde424f754592fc:"
        }
      ]
    },
    {
      "id": "claim_74aa4fd10ae944c3a9971835b74bbdad",
      "statement": "Each downloaded GDELT file's parsed rows and the file's own 'downloaded' marker are written to gkg_file/gkg_row in a single SQLite transaction, so a file is only ever marked stored together with its rows, and a skipped (404) file is recorded with rows=0 so it is not re-requested.",
      "evidence": [
        {
          "resource": "repo://gdelt.py#L88-L96",
          "version": "repo-lines-v1:sha256:a15a3661bca72744e26fa6f334dddbeaa576801905c9323f0d97497e95efb7bf:"
        }
      ]
    },
    {
      "id": "claim_98172d296e9e4ed1bbce692b5563cf0d",
      "statement": "Jev (typesafe_sdk.TypeSafeClient) is called exactly twice in the pipeline, once from triage.py to score all 30 candidate stories' severity in a single system_one request, and once from verify.py to check support/currency/sector for all claims across all findings in a single system_one request.",
      "evidence": [
        {
          "resource": "repo://triage.py#L36-L44",
          "version": "repo-lines-v1:sha256:8f6e9543ac82a284e850d9572175c496d0b1f9dce49438b86f639f526252a446:"
