    },
    {
      "id": "claim_4b4a9d4d9306406bb445659237470443",
      "statement": "gdelt.py's market_rows() writes gkg_file/gkg_row: for each 15-minute timestamp in the requested window it checks which files are already stored, downloads only the missing ones in parallel, and inserts a file's rows together with its gkg_file marker in a single transaction, so overlapping windows download only new files and a crash mid-insert causes the file to be retried rather than marked fetched-but-empty.",
      "evidence": [
        {
          "resource": "repo://gdelt.py#L72-L96",
          "version": "repo-lines-v1:sha256:1b9c05a6797ceade054cbe01af591166479f245c6ad7279b72a5817de7623db5:"
        }
      ]
    },
