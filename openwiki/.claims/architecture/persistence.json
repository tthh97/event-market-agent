    {
      "id": "claim_8732f06ab77444e98947ca29ccb41a97",
      "statement": "gkg_file is keyed by the GDELT GKG file's own UTC timestamp (at) and records how many market rows it contained (0 when GDELT returned 404/skipped); gkg_row is keyed by GDELT's own GKGRECORDID so the same article is never stored twice.",
      "evidence": [
        {
          "resource": "repo://db.py#L17-L32",
          "version": "repo-lines-v1:sha256:31c3288404611e4fb4b18a4b4bc15ad49be9169c83ad6e29264b6b94a8b84e47:"
        }
