    {
      "id": "claim_fd180a5d4a6b4fed88b6ee2816a5019c",
      "statement": "data/events.db (db.py) is an append-only SQLite database distinct from data/threads.db: all inserts use INSERT ... ON CONFLICT DO NOTHING against natural keys, and db.connect() creates the schema with CREATE TABLE IF NOT EXISTS if missing.",
